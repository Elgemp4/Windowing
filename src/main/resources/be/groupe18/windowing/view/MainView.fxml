<?xml version="1.0" encoding="UTF-8" ?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import be.groupe18.windowing.presentation.components.NumericTextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?> <?import javafx.geometry.Insets?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>

<BorderPane
  xmlns="http://javafx.com/javafx"
  xmlns:fx="http://javafx.com/fxml"
  fx:controller="be.groupe18.windowing.presentation.viewController.MainViewController"
  prefHeight="800.0"
  prefWidth="1000.0"
>

    <top>
        <VBox
      style="-fx-background-color: #f4f4f4; -fx-border-color: #cccccc; -fx-border-width: 0 0 1 0;"
    >
            <children>
                <HBox spacing="15.0" alignment="CENTER_LEFT">
                    <padding>
                        <Insets top="10" right="10" bottom="5" left="10" />
                    </padding>
                    <children>
                        <Button
                            fx:id="loadSceneButton"
                            text="Charger Scène"
                            onAction="#onLoadClicked"
                        />
                        
                        <Label
                            fx:id="errorLabel"
                            textFill="red"
                            style="-fx-font-weight: bold;"
                        />
                        <Label
                            fx:id="successLabel"
                            textFill="green"
                            style="-fx-font-weight: bold;"
                        />
                        
                        <Region HBox.hgrow="ALWAYS" />
                        
                        <Label
                            fx:id="totalCountLabel"
                            textFill="black"
                        />
                    </children>
                </HBox>

                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <padding>
                        <Insets top="5" right="10" bottom="10" left="10" />
                    </padding>
                    <children>
                        <Label
              text="Query Window : "
              style="-fx-font-weight: bold;"
            />
                        
                        <Label text="X min:" />
                        <NumericTextField
              fx:id="xMinField"
              prefWidth="60.0"
              text="0"
            />
                        
                        <Label text="X max:" />
                        <NumericTextField
              fx:id="xMaxField"
              prefWidth="60.0"
              text="100"
            />
                        
                        <Label text="Y min:" />
                        <NumericTextField
              fx:id="yMinField"
              prefWidth="60.0"
              text="0"
            />
                        
                        <Label text="Y max:" />
                        <NumericTextField
              fx:id="yMaxField"
              prefWidth="60.0"
              text="100"
            />

                        <Button
              text="Exécuter Query"
              onAction="#onQueryClicked"
              style="-fx-base: #e1f5fe;"
            />
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>

    <center>
        <Pane fx:id="canvasContainer">
            <Canvas fx:id="mainCanvas" />
        </Pane>
    </center>

</BorderPane>
